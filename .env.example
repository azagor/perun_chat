# PerunChat production configuration.
# Copy this file to .env and fill in real values before running the gateway.

# Required: 256-bit (32-byte) HMAC secret for signing HITL approval tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PERUNCHAT_SECRET=CHANGE_ME_TO_A_64_CHAR_HEX_SECRET

# SQLite database path. Defaults to ~/.perunchat/perunchat.db if unset.
PERUNCHAT_DB_PATH=/var/lib/perunchat/perunchat.db

# Fail-closed cap for the append-only consumed-HITL-nonce table. Tokens never
# expire, so nonces are not pruned by time; at capacity new approvals are
# rejected instead of risking a replay. Raise it for high-volume deployments.
# To reclaim space, rotate PERUNCHAT_SECRET and prune explicitly (see DEPLOY.md).
PERUNCHAT_MAX_CONSUMED_NONCES=100000

# Gateway bind address/port. Use 127.0.0.1 when behind Nginx.
PERUNCHAT_HOST=127.0.0.1
PERUNCHAT_PORT=8765
